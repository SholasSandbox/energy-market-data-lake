{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AWSCloudTrailAclCheck20150319",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::REPLACE_WITH_LOG_ARCHIVE_BUCKET_NAME",
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": "arn:aws:cloudtrail:REPLACE_WITH_HOME_REGION:REPLACE_WITH_MANAGEMENT_ACCOUNT_ID:trail/REPLACE_WITH_TRAIL_NAME"
        }
      }
    },
    {
      "Sid": "AWSCloudTrailWriteManagementAccount20150319",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_LOG_ARCHIVE_BUCKET_NAME/AWSLogs/REPLACE_WITH_MANAGEMENT_ACCOUNT_ID/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceArn": "arn:aws:cloudtrail:REPLACE_WITH_HOME_REGION:REPLACE_WITH_MANAGEMENT_ACCOUNT_ID:trail/REPLACE_WITH_TRAIL_NAME"
        }
      }
    },
    {
      "Sid": "AWSCloudTrailOrganizationWrite20150319",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_LOG_ARCHIVE_BUCKET_NAME/AWSLogs/REPLACE_WITH_ORGANIZATION_ID/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceArn": "arn:aws:cloudtrail:REPLACE_WITH_HOME_REGION:REPLACE_WITH_MANAGEMENT_ACCOUNT_ID:trail/REPLACE_WITH_TRAIL_NAME"
        }
      }
    }
  ]
}
