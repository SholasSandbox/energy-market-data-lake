{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDeletingOrWeakeningCentralLogBuckets",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:DeleteBucketPolicy",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutBucketAcl",
        "s3:PutBucketPolicy",
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_LOG_ARCHIVE_BUCKET_NAME",
        "arn:aws:s3:::REPLACE_WITH_LOG_ARCHIVE_BUCKET_NAME/*"
      ]
    }
  ]
}
