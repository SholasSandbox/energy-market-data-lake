{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AWSConfigBucketPermissionsCheckManagement",
      "Effect": "Allow",
      "Principal": {
        "Service": "config.amazonaws.com"
      },
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::org-config-log-archive-955659429518-eu-west-2",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "349687196588"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:config:eu-west-2:349687196588:*"
        }
      }
    },
    {
      "Sid": "AWSConfigBucketExistenceCheckManagement",
      "Effect": "Allow",
      "Principal": {
        "Service": "config.amazonaws.com"
      },
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::org-config-log-archive-955659429518-eu-west-2",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "349687196588"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:config:eu-west-2:349687196588:*"
        }
      }
    },
    {
      "Sid": "AWSConfigBucketDeliveryManagement",
      "Effect": "Allow",
      "Principal": {
        "Service": "config.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::org-config-log-archive-955659429518-eu-west-2/AWSLogs/349687196588/Config/*",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "349687196588",
          "s3:x-amz-acl": "bucket-owner-full-control"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:config:eu-west-2:349687196588:*"
        }
      }
    },
    {
