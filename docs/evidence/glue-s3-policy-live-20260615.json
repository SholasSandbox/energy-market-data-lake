{
    "RoleName": "energy-market-glue-role",
    "PolicyName": "energy-market-glue-s3-policy",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Action": "s3:GetBucketLocation",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::energy-market-lake-464975959576-20260405",
                "Sid": "ReadBucketLocation"
            },
            {
                "Action": [
                    "s3:ListBucketVersions",
                    "s3:ListBucket"
                ],
                "Condition": {
                    "StringLike": {
                        "s3:prefix": [
                            "raw",
                            "raw/*",
                            "curated",
                            "curated/*",
                            "scripts",
                            "scripts/*"
                        ]
                    }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::energy-market-lake-464975959576-20260405",
                "Sid": "ListRequiredPrefixes"
            },
            {
                "Action": [
                    "s3:GetObjectVersion",
                    "s3:GetObject"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::energy-market-lake-464975959576-20260405/scripts/*",
                    "arn:aws:s3:::energy-market-lake-464975959576-20260405/raw/*",
                    "arn:aws:s3:::energy-market-lake-464975959576-20260405/curated/*"
                ],
                "Sid": "ReadSourceCatalogAndScriptObjects"
            },
            {
                "Action": [
                    "s3:PutObject",
                    "s3:ListMultipartUploadParts",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                ],
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::energy-market-lake-464975959576-20260405/curated/*",
                "Sid": "WriteCuratedObjectsOnly"
            }
        ]
    }
}
