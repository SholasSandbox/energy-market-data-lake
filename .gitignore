.DS_Store
.env
.env.*
.venv/
*.pyc
*.pyo
*.swp
*.tmp
__pycache__/

# Terraform state should never be committed.
*.tfstate
*.tfstate.*
.terraform/
**/.terraform/
**/terraform.tfvars
**/terraform.tfvars.json
**/backend.hcl
**/tfplan*

# Python caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend build artifacts
dashboard-ui/node_modules/
dashboard-ui/dist/
dashboard-ui/.vite/
*.tsbuildinfo

# Local demo outputs
docs/evidence/*.html
docs/evidence/run-*.md
!docs/evidence/run-entsog-gas-*.md
docs/evidence/run-summary-*.md
docs/evidence/athena-run-*.md
docs/evidence/athena-schema-*.md

# Private governance evidence exports that may contain contact or account PII.
docs/evidence/private/
docs/evidence/raw-private/
*.private.json
*.private.md

# IDE files
.idea/
.vscode/*
!.vscode/settings.json
