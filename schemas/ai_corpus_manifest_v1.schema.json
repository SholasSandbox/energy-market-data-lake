          }
        }
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_id",
        "evidence_kind",
        "version",
        "content_sha256",
        "prior_authority_class",
        "lifecycle_status",
        "decision_at",
        "reason_code",
        "replacement_pointer",
        "content_retained"
      ],
      "properties": {
        "stable_id": {
          "type": "string",
          "pattern": "^(SF|DOC|DP)-[0-9]{2}$"
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "structured_evidence",
            "document",
            "passage"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prior_authority_class": {
          "type": "string",
          "enum": [
            "authoritative_structured",
            "approved_document"
          ]
        },
        "lifecycle_status": {
          "type": "string",
          "enum": [
            "superseded",
            "revoked",
            "source_deleted",
            "quarantined",
            "excluded"
          ]
        },
        "decision_at": {
          "$ref": "#/$defs/offsetDateTime"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "replacement_pointer": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stable_id",
                "version",
                "content_sha256"
              ],
              "properties": {
                "stable_id": {
                  "type": "string",
                  "pattern": "^(SF|DOC|DP)-[0-9]{2}$"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "content_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          ]
        },
        "content_retained": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "priorCompleteManifest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "type": "string",
              "const": "none"
            },
            "reason": {
              "type": "string",
              "const": "This is the initial complete local manifest; no prior complete manifest exists."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "manifest_id",
            "manifest_version",
            "manifest_hash"
          ],
          "properties": {
            "status": {
              "type": "string",
              "const": "available"
            },
            "manifest_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "manifest_version": {
              "type": "integer",
              "minimum": 1
            },
            "manifest_hash": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    }
  }
}
