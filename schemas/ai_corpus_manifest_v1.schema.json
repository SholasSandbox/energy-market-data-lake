              "pattern": "^DP-0[1-8]-C001$"
            },
            "passage_sha256": {
              "type": "string",
              "enum": [
                "c18d1b1e7ff8d0cda615dba4ee3c8d26fea2a31f52e2976d89111e28c38ed848",
                "686119ad33c718a3d9782fe2f40d96bee1750494a8e5f288fb22da23f589b165",
                "c087585acecfe3b8c9df75fabffd93835196aca820d15e234f73002cc405ee05",
                "91e9be8dbf13f86709e2a52d7351d9bd95fd24ec7f4de05d0a16358e17389077",
                "9971561cc27ae9cc949d7c34d18729a7eb181722528b721a78c77346857325e8",
                "cdec9451a35b443fafe39db52064f9c606ab4cfacce9a64aba7eacd5fcecb7be",
                "c6e9b83b31bbb589c6ec63fa9eb3cf38cc4e78552971eb53332008800366973d",
