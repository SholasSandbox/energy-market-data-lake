            "DOC-04",
            "DOC-05",
            "DOC-06",
            "DOC-07",
            "DOC-08"
          ]
        },
        "document_version": {
          "type": "integer",
          "const": 1
        },
        "document_content_sha256": {
          "type": "string",
          "enum": [
            "ff34b9be336f7d11fad53be352d587bf1b183789137cede06553c21bd151d68d",
            "64fb6682dfe535be2a57d77fe030902dbb3e51b1749348f3c7b04c0f6971a4a7",
            "ca8ea34b5a5911abb8d81226cb1f900be70ff3db85a079b8e19991f6f2829d63",
            "c6e88f3d2cfca088776f60db7e10bf82d5840629a4d8f475a2539d190015fe81",
            "88e5d33fc0b98cdabf2b760d6a674891dfa2d7d17a91f0d3d358f7cd68a9cadb",
            "ed54ca5f0f88ad2c62e6bcf552c8c22029782fa423370d304bccdd84003fcdd1",
            "669b798edd16fec6080a6914c2251d0709994c1a0ab470c1e1ca29accc805bea",
            "8a73aeccc2c764b7a116481e6be3326eaafcfc664ea92e1c3735d1a727c21599"
          ]
        },
        "contract_version": {
          "type": "string",
          "const": "ai_document_evidence_v1"
        },
        "source_record_pointer": {
          "type": "string",
          "pattern": "^/document_passages/[0-7]$"
        },
        "publisher_id": {
          "type": "string",
          "enum": [
            "ofgem",
            "desnz"
          ]
