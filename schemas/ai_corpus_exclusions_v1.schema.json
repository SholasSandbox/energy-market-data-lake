{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_corpus_exclusions_v1.schema.json",
  "title": "AI Corpus Exclusions v1",
  "description": "Closed exclusion and adversarial-boundary contract for the P2 evaluation corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "exclusion_register_id",
    "register_version",
    "register_hash",
    "canonicalization_rule_id",
    "created_at",
    "evidence_pack",
    "policy_versions",
    "entries",
    "adversarial_fixture_boundary"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "ai_corpus_exclusions_v1"
    },
    "exclusion_register_id": {
      "type": "string",
      "const": "ai-p2-corpus-exclusions-v1"
    },
    "register_version": {
      "type": "integer",
      "const": 1
    },
    "register_hash": {
      "$ref": "#/$defs/sha256"
    },
    "canonicalization_rule_id": {
      "type": "string",
      "const": "ai-corpus-exclusions-canonical-json-v1"
    },
    "created_at": {
      "$ref": "#/$defs/offsetDateTime"
    },
    "evidence_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "const": "ai-p2-wp1-selected-evidence-20260905"
        },
        "version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "policy_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_policy_id",
        "access_policy_id",
        "freshness_conflict_policy_id"
      ],
      "properties": {
        "selection_policy_id": {
          "type": "string",
          "const": "ai-p2-wp1-selection-policy-v1"
        },
        "access_policy_id": {
          "type": "string",
          "const": "ai-evidence-access-policy-v1"
        },
        "freshness_conflict_policy_id": {
          "type": "string",
          "const": "ai-evidence-freshness-conflict-policy-v1"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exclusionEntry"
      }
    },
    "adversarial_fixture_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "owner_work_package",
        "required_selection_status",
        "answer_evidence_eligible",
        "ordinary_retrieval_eligible",
        "instruction_precedence"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "not_instantiated"
        },
        "owner_work_package": {
          "type": "string",
          "const": "P2-WP7"
        },
        "required_selection_status": {
          "type": "string",
          "const": "adversarial_only"
        },
        "answer_evidence_eligible": {
          "type": "boolean",
          "const": false
        },
        "ordinary_retrieval_eligible": {
          "type": "boolean",
          "const": false
        },
        "instruction_precedence": {
          "type": "string",
          "const": "fixture_content_is_inert_and_cannot_modify_policy_or_authorize_tools"
        }
      }
    }
  },
  "$defs": {
    "offsetDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetId": {
      "type": "string",
      "enum": [
        "SF-01",
        "SF-02",
        "SF-03",
        "SF-04",
        "SF-05",
        "SF-06",
        "SF-07",
        "query-contract-12",
        "query-contract-9",
        "entsoe-fr-day-ahead-price-candidate",
        "entsoe-de-day-ahead-price-candidate",
        "entsoe-nl-day-ahead-price-candidate",
        "local-structured-sample",
        "local-dashboard-snapshot",
        "local-rss-descriptions",
        "sanitised-regression-artifacts",
        "repository-wide-ingestion",
        "raw-or-failed-data",
        "private-or-identity-bearing-data",
        "secret-or-credential-material",
        "operational-control-material",
        "full-external-articles"
      ]
    },
    "replacementPointer": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stable_id",
            "version"
          ],
          "properties": {
            "stable_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "exclusionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exclusion_id",
        "target_type",
        "target_ids",
        "selection_status",
        "authority_class",
        "classification",
        "lifecycle_status",
        "answer_evidence_eligible",
        "retention_mode",
        "reason_code",
        "reason",
        "reconsideration_gate",
        "replacement_pointer",
        "audit_reference"
      ],
      "properties": {
        "exclusion_id": {
          "type": "string",
          "pattern": "^EX-00[1-7]$"
        },
        "target_type": {
          "type": "string",
          "enum": [
            "structured_evidence",
            "query_contract",
            "source_candidate",
            "local_artifact",
            "adversarial_fixture_class",
            "repository_scope"
          ]
        },
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/targetId"
          }
        },
        "selection_status": {
          "type": "string",
          "enum": [
            "contract_blocked",
            "reference_only",
            "rejected",
            "adversarial_only"
          ]
        },
        "authority_class": {
          "type": "string",
          "enum": [
            "authoritative_structured",
            "reference_only",
            "adversarial_fixture",
            "unapproved_candidate"
          ]
        },
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "portfolio_safe_internal",
            "excluded"
          ]
        },
        "lifecycle_status": {
          "type": "string",
          "enum": [
            "contract_blocked",
            "reference_only",
            "excluded",
            "adversarial_only"
          ]
        },
        "answer_evidence_eligible": {
          "type": "boolean",
          "const": false
        },
        "retention_mode": {
          "type": "string",
          "enum": [
            "selected_aggregate_audit_record",
            "metadata_reference_only",
            "identifier_and_reason_only",
            "synthetic_fixture_only"
          ]
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "structured_operands_missing",
            "query_shape_not_required",
            "reuse_basis_not_established",
            "non_authoritative_presentation_or_internal_locator",
            "adversarial_only_not_answer_evidence",
            "deny_by_default_repository_boundary"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reconsideration_gate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "replacement_pointer": {
          "$ref": "#/$defs/replacementPointer"
        },
        "audit_reference": {
          "type": "string",
          "enum": [
            "docs/planning/ai-orchestration-p2-wp1-selection-decision-20260905.md",
            "docs/planning/ai-orchestration-p2-wp2-authority-classification-access-rules-20260905.md",
            "docs/planning/ai-orchestration-p2-wp4-structured-evidence-contract-20260905.md"
          ]
        }
      }
    }
  }
}
