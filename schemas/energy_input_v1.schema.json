
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "energy_input_v1.schema.json",
  "title": "Energy Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "records"],
  "properties": {
    "schema_version": { "type": "string", "const": "energy_input_v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "dataset",
          "region",
          "timestamp_utc",
          "date",
          "settlement_period",
          "demand_mw",
          "source_reference"
        ],
        "properties": {
          "source": { "type": "string", "enum": ["elexon", "entsoe", "entsog"] },
          "dataset": { "type": "string" },
          "region": { "type": "string" },
          "timestamp_utc": { "type": "string", "format": "date-time" },
          "date": { "type": "string", "format": "date" },
          "settlement_period": { "type": ["integer", "null"], "minimum": 1, "maximum": 50 },
          "demand_mw": { "type": ["number", "null"] },
          "system_sell_price_gbp_mwh": { "type": ["number", "null"] },
          "system_buy_price_gbp_mwh": { "type": ["number", "null"] },
          "day_ahead_price_eur_mwh": { "type": ["number", "null"] },
          "source_reference": { "type": "string" }
        }
      }
    }
  }
}