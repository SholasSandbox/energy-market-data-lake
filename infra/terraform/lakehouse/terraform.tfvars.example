aws_region     = "eu-west-2"
project_prefix = "energy-market"
environment    = "dev"

# Use the existing data lake bucket by default. Set create_data_bucket = true
# only when you want Terraform to create a new data lake bucket.
create_data_bucket = false
data_bucket_name   = "energy-market-lake-464975959576-20260405"

backfill_days        = 1
schedule_enabled     = false
schedule_expression  = "cron(0 2 * * ? *)"

# Phase 8 deterministic AI insight orchestration. Build the Lambda zip first:
# ../../../scripts/build_phase8_lambda_package.sh
create_dashboard_bucket = false
dashboard_bucket_name   = "energy-market-dashboard-public-464975959576-20260405"

# Phase 12 static dashboard delivery foundation. Leave disabled until you are
# ready to create a Terraform-managed dashboard bucket and CloudFront
# distribution for public-safe dashboard assets.
dashboard_cloudfront_enabled     = false
dashboard_cloudfront_price_class = "PriceClass_100"

ai_orchestration_enabled               = false
ai_orchestration_lambda_package_path   = ".terraform/build/news_ai_orchestration.zip"
ai_orchestration_schedule_enabled      = false
ai_orchestration_schedule_expression   = "cron(30 7 * * ? *)"
ai_orchestration_dashboard_data_key    = "dashboard/dashboard-data.json"
ai_orchestration_news_limit_per_feed   = 4
ai_orchestration_news_max_articles     = 18
ai_orchestration_sns_email             = ""
ai_orchestration_managed_ai_enabled    = false
ai_orchestration_bedrock_model_id      = "mistral.ministral-3-8b-instruct"
ai_orchestration_bedrock_provider      = "mistral"
ai_orchestration_bedrock_max_tokens    = 1600
ai_orchestration_bedrock_temperature   = 0.2

# Optional managed workflow monthly cost budget. Keep disabled until a budget
# alarm execution boundary explicitly approves the guardrail.
managed_workflow_cost_budget_enabled            = false
managed_workflow_cost_budget_name               = "energy-market-managed-workflow-monthly-cost"
managed_workflow_cost_budget_limit_usd          = 1
managed_workflow_cost_budget_notification_email = ""
managed_workflow_cost_budget_services = [
  "Amazon Bedrock",
  "AWS Lambda",
  "AWS Step Functions",
  "Amazon Simple Storage Service",
  "Amazon CloudFront",
  "Amazon Simple Notification Service",
  "AmazonCloudWatch",
]

entsog_point_directions = "BE-TSO-0001ITP-00061entry,BE-TSO-0001ITP-00115exit,CZ-TSO-0001ITP-00537entry,BE-TSO-0001ITP-00555exit"
entsog_flow_indicator   = "Physical Flow"
entsog_demand_indicator = "Allocation"
entsog_period_type      = "day"
entsog_timezone         = "WET"
entsog_limit            = 1000
entsog_include_exemptions = 0

tags = {
  Workload = "energy-market-data-lake"
}
