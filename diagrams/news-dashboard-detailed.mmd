flowchart TD
    subgraph External["External sources outside AWS trust boundary"]
        Elexon["Elexon API\nUK demand and imbalance"]
        Entsoe["ENTSO-E API\nEU load and prices"]
        Entsog["ENTSOG API\nPhysical Flow + Allocation"]
        RSS["RSS feeds\nenergy market news"]
    end

    subgraph AWS["AWS account boundary"]
        Secrets["SSM / Secrets Manager\nAPI tokens and runtime config"]

        subgraph Private["Private processing boundary"]
            EnergySchedule["EventBridge energy schedule\nDISABLED"]
            AISchedule["EventBridge AI schedule\nENABLED daily"]
            Workflow["Step Functions execution\nscheduled managed path"]

            EnergyLambda["Energy ingest Lambda\nElexon / ENTSO-E / ENTSOG"]
            OrchestrationLambda["news_ai_orchestration Lambda\nworkflow action dispatcher"]

            subgraph DataBucket["S3 data bucket - private"]
                Raw["raw/\nsource=elexon / entsoe / entsog / news"]
                Curated["curated/\nelectricity / gas / news / ai insight"]
                Audit["audit/\nrun-scoped successful publishes"]
                Failed["failed/\nvalidation and runtime failures"]
            end

            GlueCrawler["Glue crawler"]
            GlueETL["Glue ETL\nraw to Parquet"]
            Catalog["Glue Data Catalog"]
            Athena["Athena curated queries"]

            EnergyInput["Build energy_input_v1"]
            NewsSummary["Build news_summary_v1"]
            Bundle["Build ai_input_bundle_v1"]
            ManagedMerge["Managed insight action\nBedrock adapter"]
            Bedrock["Amazon Bedrock Runtime\nMistral model invocation"]
            DeterministicMerge["Deterministic merge\nfallback and baseline"]
            AIValidate["Validate ai_insight_v1"]
            DashboardValidate["Validate dashboard_snapshot_v1"]
            Publish["Publish approved dashboard snapshot"]

            subgraph Observability["Implemented operating signals"]
                Logs["CloudWatch Logs"]
                SNS["SNS failure notification"]
            end
        end

        subgraph Public["Public dashboard boundary"]
            DashboardData["Approved dashboard JSON\npublic fields only"]
        end
    end

    ReactDashboard["React dashboard\nPhase 10 Overview"]
    Viewer["Dashboard user"]
    StaticHosting["CloudFront + S3\npublic static delivery"]

    Elexon --> EnergyLambda
    Entsoe --> EnergyLambda
    Entsog --> EnergyLambda
    Secrets --> EnergyLambda
    EnergySchedule --> EnergyLambda
    EnergyLambda --> Raw

    Raw --> GlueCrawler
    GlueCrawler --> Catalog
    Raw --> GlueETL
    Catalog --> GlueETL
    GlueETL --> Curated
    Curated --> Athena
    Catalog --> Athena
    Athena --> EnergyInput

    RSS --> OrchestrationLambda
    AISchedule --> Workflow
    Workflow --> OrchestrationLambda
    OrchestrationLambda --> EnergyInput
    OrchestrationLambda --> NewsSummary
    OrchestrationLambda --> Bundle
    OrchestrationLambda --> ManagedMerge
    OrchestrationLambda -. "fallback" .-> DeterministicMerge
    ManagedMerge --> Bedrock
    Bedrock --> ManagedMerge
    DeterministicMerge -. "fallback" .-> AIValidate

    EnergyInput --> Bundle
    NewsSummary --> Bundle
    Bundle --> ManagedMerge
    ManagedMerge --> AIValidate
    AIValidate -->|valid| DashboardValidate
    AIValidate -->|invalid| Failed
    DashboardValidate -->|valid| Publish
    DashboardValidate -->|invalid| Failed
    Publish --> Audit
    Publish --> DashboardData
    OrchestrationLambda --> Curated

    EnergyLambda --> Logs
    OrchestrationLambda --> Logs
    AIValidate -->|invalid| SNS
    DashboardValidate -->|invalid| SNS

    Viewer --> ReactDashboard
    ReactDashboard --> DashboardData
    StaticHosting --> ReactDashboard
