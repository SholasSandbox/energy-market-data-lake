flowchart TD
    subgraph External["External sources"]
        Elexon["Elexon API\nUK power"]
        Entsoe["ENTSO-E API\nEU power"]
        Entsog["ENTSOG API\nEU gas\nPhysical Flow + Allocation"]
        RSS["RSS feeds\nenergy market news"]
    end

    subgraph Private["Private AWS lakehouse and orchestration boundary"]
        EventBridge["EventBridge schedules\ncreated but disabled"]
        IngestLambda["Ingestion Lambda\nenergy raw payloads"]
        StepFunctions["Step Functions\nmanual Phase 8 execution"]
        NewsAI["news_ai_orchestration Lambda\ndeterministic workflow actions"]

        Raw["S3 raw/\nElexon / ENTSO-E / ENTSOG / news"]
        Curated["S3 curated/\nelectricity / gas / news / ai insight"]
        Audit["S3 audit/\nrun-scoped publish records"]
        Failed["S3 failed/\nvalidation and runtime failures"]

        GlueCrawler["Glue crawler"]
        GlueCatalog["Glue Data Catalog"]
        GlueETL["Glue ETL Job\nraw to curated Parquet"]
        Athena["Athena\ncurated SQL"]
        Validation["Schema validation gates\nenergy, news, AI insight, dashboard snapshot"]
        SNS["SNS failure notification"]
    end

    subgraph Public["Public dashboard boundary"]
        DashboardJSON["Approved public dashboard JSON"]
        ReactDashboard["React dashboard\nPhase 10 Overview"]
    end

    Analyst["Analyst / demo queries"]
    Viewer["Dashboard user"]

    Elexon --> IngestLambda
    Entsoe --> IngestLambda
    Entsog --> IngestLambda
    EventBridge -. "disabled schedule" .-> IngestLambda
    IngestLambda --> Raw

    Raw --> GlueCrawler
    GlueCrawler --> GlueCatalog
    Raw --> GlueETL
    GlueCatalog --> GlueETL
    GlueETL --> Curated
    Curated --> Athena
    GlueCatalog --> Athena

    RSS --> NewsAI
    StepFunctions --> NewsAI
    NewsAI --> Validation
    Athena --> Validation
    Validation -->|valid| Curated
    Validation -->|valid publish| Audit
    Validation -->|valid publish| DashboardJSON
    Validation -->|invalid| Failed
    Validation -->|invalid| SNS

    Analyst --> Athena
    Viewer --> ReactDashboard
    ReactDashboard --> DashboardJSON
